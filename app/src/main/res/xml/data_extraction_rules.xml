<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules).
  Cloud backup is NOT enabled: the privacy promise is that financial data does
  not leave the device. Device-to-device transfer is allowed, since that is a
  direct user-initiated migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app-data" />
        <exclude domain="file" path="app-data/backup" />
    </device-transfer>
</data-extraction-rules>
