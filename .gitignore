*.iml
.gradle/

# Android Studio / IntelliJ — machine-specific, regenerated on import.
# Ignored wholesale rather than file-by-file: Studio adds new files here with
# every release, and none of them are needed to build the project.
/.idea/

.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Keystores / signing — never commit
*.jks
*.keystore
keystore.properties
signing.properties

# Build outputs
/app/build/
/app/release/
*.apk
*.aab
*.ap_
*.dex
*.class

# Logs & reports
*.log
/app/build/reports/

# OS cruft
Thumbs.db
desktop.ini
